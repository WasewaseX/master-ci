{
  "code": [
    "**/*.py",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "**/*.mjs",
    "**/*.cjs",
    "**/*.rs",
    "**/*.go",
    "**/*.java",
    "**/*.rb",
    "**/*.php",
    "**/*.c",
    "**/*.cpp",
    "**/*.h",
    "**/*.sh",
    "!**/dist/**",
    "!**/build/**",
    "!**/target/**",
    "!**/vendor/**",
    "!**/coverage/**",
    "!**/node_modules/**"
  ],
  "docker": [
    "**/Dockerfile*",
    "**/*.dockerfile"
  ],
  "docs": [
    "**/*.md",
    "**/*.mdx",
    "**/*.rst",
    "!**/dist/**",
    "!**/build/**",
    "!**/target/**",
    "!**/vendor/**",
    "!**/coverage/**",
    "!**/node_modules/**"
  ],
  "go": [
    "**/*.go",
    "**/go.mod",
    "**/go.sum",
    "**/go.work",
    "**/.golangci.yml",
    "**/.golangci.yaml",
    "!**/dist/**",
    "!**/build/**",
    "!**/target/**",
    "!**/vendor/**",
    "!**/coverage/**",
    "!**/node_modules/**"
  ],
  "node": [
    "**/package.json",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "**/*.mjs",
    "**/*.cjs",
    "**/biome.json*",
    "**/tsconfig*.json",
    "!**/fixtures/**",
    "!**/dist/**",
    "!**/build/**",
    "!**/target/**",
    "!**/vendor/**",
    "!**/coverage/**",
    "!**/node_modules/**"
  ],
  "python": [
    "**/*.py",
    "**/pyproject.toml",
    "**/requirements*.txt",
    "**/setup.py",
    "**/setup.cfg",
    "**/mypy.ini",
    "**/ruff.toml",
    "**/.ruff.toml",
    "!**/dist/**",
    "!**/build/**",
    "!**/target/**",
    "!**/vendor/**",
    "!**/coverage/**",
    "!**/node_modules/**"
  ],
  "rust": [
    "**/*.rs",
    "**/Cargo.toml",
    "**/Cargo.lock",
    "**/rust-toolchain*",
    "**/deny.toml",
    "!**/dist/**",
    "!**/build/**",
    "!**/target/**",
    "!**/vendor/**",
    "!**/coverage/**",
    "!**/node_modules/**"
  ],
  "workflows": [
    ".github/workflows/**",
    ".github/labeler.yml",
    ".github/dependabot.yml",
    ".github/codeql/**"
  ]
}
